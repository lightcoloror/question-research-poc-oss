{
  "schema_version": "research-evidence-lifecycle-adapter.v1",
  "profile_id": "research_evidence",
  "producer_tool_id": "question-research-poc",
  "owner_lane": "research-evidence",
  "allowed_roots": ["tests/fixtures/artifact-lifecycle/research-evidence"],
  "default": {"artifact_role": "evidence_receipt_manifest", "lifecycle_state": "candidate", "referenced_by": ["unknown_reference"], "sensitivity": "unknown", "pin": true},
  "rules": [
    {"path": "evidence/evidence-bundle.json", "artifact_role": "authoritative_input", "lifecycle_state": "verified", "referenced_by": ["claims/claim-graph.json"], "pin": true},
    {"path": "evidence/source-refs.json", "artifact_role": "authoritative_input", "lifecycle_state": "verified", "referenced_by": ["evidence/evidence-bundle.json"], "pin": true},
    {"path": "claims/claim-graph.json", "artifact_role": "evidence_receipt_manifest", "lifecycle_state": "verified", "referenced_by": ["review/review-packet.json"], "pin": true},
    {"path": "review/factcheck-decision.json", "artifact_role": "evidence_receipt_manifest", "lifecycle_state": "verified", "referenced_by": ["review/review-packet.json"], "pin": true},
    {"path": "answers/guarded-answer.json", "artifact_role": "final_deliverable", "lifecycle_state": "verified", "referenced_by": ["review/review-packet.json"], "pin": true},
    {"path": "content/content-brief.json", "artifact_role": "final_deliverable", "lifecycle_state": "candidate", "referenced_by": ["review/review-packet.json"], "pin": true},
    {"path": "review/review-packet.json", "artifact_role": "evidence_receipt_manifest", "lifecycle_state": "verified", "referenced_by": ["closure/checkpoint.json"], "pin": true},
    {"path": "closure/checkpoint.json", "artifact_role": "runtime_state", "lifecycle_state": "locked", "referenced_by": ["receipts/closure-receipt.json"], "pin": true},
    {"path": "approvals/review-approval.json", "artifact_role": "evidence_receipt_manifest", "lifecycle_state": "verified", "referenced_by": ["receipts/closure-receipt.json"], "pin": true},
    {"path": "receipts/closure-receipt.json", "artifact_role": "evidence_receipt_manifest", "lifecycle_state": "verified", "referenced_by": ["immutable_receipt"], "pin": true},
    {"path": "cache/failed-retrieval.tmp", "artifact_role": "duplicate_or_obsolete", "lifecycle_state": "failed", "referenced_by": [], "pin": false, "rebuild_proof": {"status": "verified", "command": "rebuild --synthetic", "input_hashes": ["fixture"], "dependency_lock": "fixture-lock", "verification_ref": "receipts/closure-receipt.json"}},
    {"path": "analysis/superseded-analysis.json", "artifact_role": "reproducible_derived", "lifecycle_state": "superseded", "referenced_by": [], "pin": false, "rebuild_proof": {"status": "verified", "command": "rebuild --synthetic", "input_hashes": ["evidence/evidence-bundle.json"], "dependency_lock": "fixture-lock", "verification_ref": "receipts/closure-receipt.json"}}
  ]
}
